{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimai.nl/schemas/seat.schema.json",
  "title": ".bimai/seats/<name>/seat.yaml",
  "type": "object",
  "required": [
    "person"
  ],
  "properties": {
    "person": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "role": {
      "type": "string"
    },
    "preset": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
