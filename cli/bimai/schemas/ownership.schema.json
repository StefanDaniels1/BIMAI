{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimai.nl/schemas/ownership.schema.json",
  "title": ".bimai/ownership.yaml",
  "type": "object",
  "properties": {
    "positions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "role",
          "held_by"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "scope": {
            "type": "object"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "held_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "lead": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "cover": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "by"
        ],
        "properties": {
          "position": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "by": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "until": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
