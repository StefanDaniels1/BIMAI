{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimai.nl/schemas/automation.schema.json",
  "title": ".bimai/automations/<id>.yaml",
  "type": "object",
  "required": [
    "id",
    "workflow",
    "schedule"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "workflow": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schedule": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "mode": {
      "enum": [
        "read-only",
        "gated-write"
      ]
    }
  }
}
