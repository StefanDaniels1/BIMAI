{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimai.nl/schemas/people.schema.json",
  "title": ".bimai/people.yaml",
  "type": "object",
  "required": [
    "people"
  ],
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "seat": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "external": {
            "type": "boolean"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": "string"
          }
        }
      }
    }
  }
}
